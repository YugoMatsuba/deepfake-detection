# ============================================================================
# LOCAL DEVELOPMENT CONFIGURATION (.env.local.example)
# ============================================================================
#
# This is the environment configuration for LOCAL DEVELOPMENT.
# Copy this file to .env in the root directory:
#   cp .env.local.example .env
#
# For production deployment, use .env.production.example instead.
#
# ============================================================================

# ============================================================================
# ENVIRONMENT & RUNTIME
# ============================================================================

# Runtime environment (development for local work)
ENVIRONMENT=development

# Flask application port
PORT=5050

# Data directory inside container
DATA_DIR=/data

# ============================================================================
# SECURITY
# ============================================================================

# SECRET_KEY: Flask session signing key (dev key is fine for local)
SECRET_KEY=dev-insecure

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL via docker-compose)
# ============================================================================

# PostgreSQL credentials (single source of truth)
# IMPORTANT: If you change POSTGRES_PASSWORD after first `docker compose up`:
#
#   Option A: Delete volume (simple, loses all data)
#     docker compose down
#     docker volume rm deepfake_ai_pgdata
#     docker compose up -d
#     docker compose run --rm backend bash -c "cd backend && alembic upgrade head"
#
#   Option B: Update password via SQL (keeps data)
#     1. docker compose down
#     2. Change POSTGRES_PASSWORD back to OLD password temporarily
#     3. docker compose up -d db
#     4. docker compose exec db psql -U deepfake -d deepfake_dev -c "ALTER USER deepfake WITH PASSWORD 'new_password';"
#     5. Change POSTGRES_PASSWORD to new password in this file
#     6. docker compose up -d
#
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=secret
POSTGRES_DB=deepfake_dev

# PostgreSQL connection string (auto-constructed from credentials above)
# Local postgres runs on localhost:5431
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5431/${POSTGRES_DB}

# Database bootstrap (auto-creates tables, bypasses migration history)
# IMPORTANT: Keep at 0 - use Alembic migrations instead (more robust)
# To create tables: docker compose run --rm backend bash -c "cd backend && alembic upgrade head"
DB_BOOTSTRAP=0

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Allowed frontend origins for local development
# Includes Vite dev server on port 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# ML & PROCESSING
# ============================================================================

# ML device (cpu for local development)
# NOTE: CUDA requires NVIDIA GPU and is untested
DEVICE=cpu

# Traditional forensics multiprocessing worker count
# Set to number of CPU cores minus 2
FORENSICS_WORKERS=4

# ============================================================================
# OWNER BOOTSTRAP (Admin User Creation)
# ============================================================================

# Owner account for local development
OWNER_USERNAME=admin
OWNER_SEED_PASSWORD=changeme123
ALLOW_OWNER_TRANSFER=1
