# Docker Compose Deployment Configuration (Linux Production)
#
# This file is specifically for the deploy/docker-compose.yml orchestration.
# Copy this to deploy/.env and customize for your deployment.
#
# For local development (devcontainer), use the root .env instead.
#
# IMPORTANT: This template is configured for Linux production deployment.
# All paths assume a Linux host system.

# ============================================================================
# ENVIRONMENT & RUNTIME
# ============================================================================

# Runtime environment (production for Docker deployment)
# IMPORTANT: MUST be "production" for deployment behind HTTPS
# When ENVIRONMENT=production, Flask sets SESSION_COOKIE_SECURE=True
# This requires HTTPS - cookies will NOT work over plain HTTP
# For local testing without HTTPS, use ENVIRONMENT=development
ENVIRONMENT=production

# Flask application port (internal container port)
PORT=5050

# Data directory inside container (do not change)
DATA_DIR=/data

# ============================================================================
# SECURITY
# ============================================================================

# SECRET_KEY: Flask session signing key (used for secure cookies, CSRF protection)
# CRITICAL: Generate a random key for production
# Command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string (db = service name from docker-compose.yml)
DATABASE_URL=postgresql+psycopg://deepfake:CHANGE_THIS_PASSWORD@db:5432/deepfake_prod

# PostgreSQL credentials
# IMPORTANT: Change these credentials for production!
# Generate strong password: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=deepfake_prod

# Database bootstrap (0 for production - use migrations instead)
DB_BOOTSTRAP=0

# ============================================================================
# DOCKER VOLUME CONFIGURATION (Linux Production Paths)
# ============================================================================

# Host directory path for persistent analysis data (videos, frames, forensic overlays)
# This path is on the HOST machine and gets mounted to /data inside the container
#
# BEFORE FIRST DEPLOYMENT:
#   1. Create host directory:
#      sudo mkdir -p /var/lib/deepfake/data
#   2. Set permissions (uid 1000 = default user in container):
#      sudo chown -R 1000:1000 /var/lib/deepfake/data
#   3. Verify: ls -ld /var/lib/deepfake/data
#
# NOTE: PostgreSQL data uses Docker-managed volume (no host path needed)
DATA_VOLUME_PATH=/var/lib/deepfake/data

# ============================================================================
# ML & PROCESSING
# ============================================================================

# ML device (cpu or cuda)
# - cpu: Safe default, works on all systems (CPU-only PyTorch)
# - cuda: Requires NVIDIA GPU with CUDA 11.3+ drivers installed on host
#
# ⚠️  IMPORTANT: If you change this from cpu to cuda (or vice versa):
#    1. Edit this value in deploy/.env
#    2. Rebuild Docker image: docker compose build --no-cache
#    3. Restart services: docker compose up -d
#    This is required because PyTorch installation is different for CPU vs CUDA
#
# ⚠️  WARNING: CUDA support is relatively untested as development hardware lacks GPU
#    Expect potential issues when switching to DEVICE=cuda
#    Test thoroughly before production use with GPU
DEVICE=cpu

# Traditional forensics multiprocessing worker count
# Set to number of CPU cores to use for parallel forensics processing
# Leave 1-2 cores for Flask/Gunicorn/system
# Example: FORENSICS_WORKERS=6 for 8-core system
FORENSICS_WORKERS=4

# ============================================================================
# OWNER BOOTSTRAP (Admin User Creation)
# ============================================================================

# OWNER_USERNAME: Username for the initial owner account
# OWNER_SEED_PASSWORD: Password for the initial owner account
# ALLOW_OWNER_TRANSFER: Set to 0 after first boot to prevent account takeover
#
# IMPORTANT SECURITY PRACTICE:
#   1. First deployment: Set ALLOW_OWNER_TRANSFER=1, start containers, login
#   2. After confirming owner account works: Set ALLOW_OWNER_TRANSFER=0, restart
#   3. This prevents anyone from bootstrapping a new owner later
OWNER_USERNAME=admin
OWNER_SEED_PASSWORD=CHANGE_THIS_PASSWORD
ALLOW_OWNER_TRANSFER=1

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Allowed frontend origins (comma-separated, NO trailing slashes)
# IMPORTANT: Update this to match your deployment domain!
#
# For production with nginx on same host serving frontend:
#   - Use http://localhost ONLY if accessing via localhost
#   - If accessing via IP: CORS_ORIGINS=http://192.168.1.100
#   - If using domain: CORS_ORIGINS=https://yourdomain.com
#   - Multiple origins: CORS_ORIGINS=https://www.example.com,https://example.com
#
# The default below ONLY works when accessing via http://localhost
CORS_ORIGINS=http://localhost
