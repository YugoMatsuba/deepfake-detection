# Docker local testing environment
# For running backend container on Mac without devcontainer

# Database (connects to postgres container via host.docker.internal)
DATABASE_URL=postgresql+psycopg://deepfake:secret@host.docker.internal:5431/deepfake_dev

# Data directory (container path - mounted from host)
DATA_DIR=/data

# Flask config
PORT=5050
SECRET_KEY=dev-test-key
ENVIRONMENT=development

# CORS for local frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Forensics workers (adjust for your CPU)
FORENSICS_WORKERS=4

# Owner Bootstrap (not needed if owner already exists in DB)
# OWNER_USERNAME=admin
# OWNER_SEED_PASSWORD=changeme123
# ALLOW_OWNER_TRANSFER=0
