# Runtime environment
ENVIRONMENT=development

# Flask port (dev override)
PORT=5050

# Security
SECRET_KEY=replace-me

# Database
DATABASE_URL=sqlite:///instance/app.db

# Database bootstrap (set to 1 to auto-create tables; use Alembic migrations in prod)
DB_BOOTSTRAP=0

# CORS (dev FE origins; comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data root (for analyses later; used by API/ML containers)
DATA_DIR=/data

# ML device (cpu or cuda; auto-detected if not set)
DEVICE=cpu
