# Runtime environment
ENVIRONMENT=development

# Flask port (dev override)
PORT=5050

# Security
# SECRET_KEY: Flask session signing key (used for secure cookies, CSRF protection)
# IMPORTANT: Generate a random key for production (e.g., `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace-me

# Database
DATABASE_URL=sqlite:///instance/app.db

# Database bootstrap (set to 1 to auto-create tables; use Alembic migrations in prod)
DB_BOOTSTRAP=0

# CORS (dev FE origins; comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data root (for analyses later; used by API/ML containers)
DATA_DIR=/data

# Docker Volume Configuration (for production deployment only)
# Host directory path for persistent analysis data (videos, frames, forensic overlays)
# This path is on the HOST machine and gets mounted to /data inside the container
# Default for Linux VM deployment: /var/lib/deepfake/data
# IMPORTANT: Create this directory on the host before first deployment:
#   sudo mkdir -p /var/lib/deepfake/data
#   sudo chown -R 1000:1000 /var/lib/deepfake/data
DATA_VOLUME_PATH=/var/lib/deepfake/data

# ML device (cpu or cuda; auto-detected if not set)
DEVICE=cpu

# Traditional forensics multiprocessing worker count
# REQUIRED: Set to number of CPU cores to use for parallel forensics processing
# Leave 1-2 cores for Flask/Gunicorn. Example: FORENSICS_WORKERS=4 for 6-core system
# WARNING: Must be set explicitly (cannot be blank)
FORENSICS_WORKERS=4

# Owner Bootstrap (admin user creation on first run)
# OWNER_USERNAME: Username for the initial owner account
# OWNER_SEED_PASSWORD: Password for the initial owner account (CHANGE THIS IN PRODUCTION!)
# ALLOW_OWNER_TRANSFER: Set to 0 to prevent creating owner if one already exists (recommended for prod)
OWNER_USERNAME=admin
OWNER_SEED_PASSWORD=changeme123
ALLOW_OWNER_TRANSFER=1
