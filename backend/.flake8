[flake8]
# Enforce stricter code quality standards
max-line-length = 127
max-complexity = 10

# Exclude generated/migration files
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    alembic/versions,
    alembic/env.py,
    build,
    dist

# Ignore specific rules (no inline comments allowed in ignore list)
ignore =
    E402,
    W503,
    W504

# Error codes to always enforce
select =
    E,
    F,
    C90,
    W

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403

# Show source code for violations
show-source = True
statistics = True
count = True
